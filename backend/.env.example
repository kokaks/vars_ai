# Copy to .env for local development. On Render, set these as real
# environment variables in the service's dashboard instead — .env is not
# deployed (it's gitignored).

# Neon connection string. Get this from the Neon dashboard -> your project
# -> Connection Details -> "Pooled connection" (recommended for a small web
# service like this one — handles connection churn better than the direct
# connection string). It already includes ?sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/barbershop?sslmode=require

# Optional: web-push reminder notifications. Generate with:
#   npx web-push generate-vapid-keys
# Leave blank to run without push (reminders just get logged server-side).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

PORT=3000
